# Online Meeting Summarizer - production environment template

DB_PASSWORD=change-me-to-a-strong-database-password
DATABASE_URL=postgresql://starlight:${DB_PASSWORD}@db:5432/meeting_summarizer
REDIS_URL=redis://redis:6379/0

SECRET_KEY=generate-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-before-production

SCHOOL_NAME=Starlight Secondary School
SCHOOL_DOMAIN=oms.arosoftlabs.com
PUBLIC_APP_URL=https://oms.arosoftlabs.com
TIMEZONE=Africa/Kampala

# Google Gemini - audio transcription, speaker refinement and structured minutes
GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# Browser requests remain same-origin; Next.js proxies /api to the backend.
NEXT_PUBLIC_API_URL=https://oms.arosoftlabs.com

# SMTP invitations and final-minutes notifications
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_USERNAME=no-reply@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_USE_SSL=true
SMTP_USE_STARTTLS=false
SMTP_VERIFY_TLS=true
