# Online Meeting Summarizer - production environment template

DB_PASSWORD=change-me-to-a-strong-database-password
DATABASE_URL=postgresql://starlight:${DB_PASSWORD}@db:5432/meeting_summarizer
REDIS_URL=redis://redis:6379/0

SECRET_KEY=generate-a-long-random-secret
ADMIN_EMAIL=admin@starlightsecondaryschool.com
ADMIN_PASSWORD=change-me-before-production

SCHOOL_NAME=Starlight Secondary School
SCHOOL_DOMAIN=starlightsecondaryschool.com
PUBLIC_APP_URL=https://starlightsecondaryschool.com
TIMEZONE=Africa/Kampala

# Google Gemini - audio transcription, speaker refinement and structured minutes
GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# Browser requests remain same-origin; Next.js proxies /api to the backend.
NEXT_PUBLIC_API_URL=https://starlightsecondaryschool.com

# Optional TURN relay for reliable cross-device WebRTC audio.
# The frontend Docker build reads these as NEXT_PUBLIC_TURN_* build args.
TURN_URLS=turn:your-turn-host-or-ip:3478?transport=udp,turn:your-turn-host-or-ip:3478?transport=tcp
TURN_USERNAME=meeting-audio
TURN_CREDENTIAL=replace-with-a-strong-turn-password

# Starlight/AroMail SMTP for invitations and meeting-minutes delivery
SMTP_HOST=stalwart
SMTP_PORT=465
SMTP_USERNAME=info@starlightsecondaryschool.com
SMTP_PASSWORD=your-mailbox-password
SMTP_FROM_EMAIL=info@starlightsecondaryschool.com
SMTP_USE_SSL=true
SMTP_USE_STARTTLS=false
# Set false while the internal Stalwart listener uses its current self-signed certificate.
SMTP_VERIFY_TLS=false
